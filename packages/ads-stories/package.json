{
  "name": "@vtex/ads-stories",
  "type": "module",
  "version": "0.3.0",
  "description": "VTEX Ads Stories web component",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/cdn/vtex-ads-stories.js",
  "jsdelivr": "dist/cdn/vtex-ads-stories.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.cts",
        "default": "./dist/cjs/react.cjs"
      }
    },
    "./cdn": "./dist/cdn/vtex-ads-stories.js"
  },
  "sideEffects": [
    "./dist/cdn/*"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/ensure-publish-auth.mjs",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rimraf dist",
    "dev": "vite",
    "preview:cdn": "tsup && vite --open /?cdn",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --coverage.enabled=false"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vtex/ads-js.git",
    "directory": "packages/ads-stories"
  },
  "homepage": "https://github.com/vtex/ads-js/tree/main/packages/ads-stories#readme",
  "peerDependencies": {
    "@types/react": ">=18.2.6"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "tsup": "^8.5.0",
    "vite": "^5.0.0"
  }
}
